# Optional copy to `server/.env` (see root `.gitignore`). Prisma CLI reads `DATABASE_URL`.
# Default matches `docker-compose.yml` (Postgres on host port 5433).
DATABASE_URL="postgresql://auction:auction_dev@localhost:5433/react_sample_auction?schema=public"

# Roboflow hosted classification endpoint for Discovery artwork matching.
# Model id format is usually "project/version", e.g. "rockefeller-artworks/1".
ROBOFLOW_API_KEY=""
ROBOFLOW_MODEL_ID=""
# Optional full endpoint override. If unset, server uses:
# https://classify.roboflow.com/${ROBOFLOW_MODEL_ID}?api_key=${ROBOFLOW_API_KEY}
ROBOFLOW_INFERENCE_URL=""
DISCOVERY_MATCH_THRESHOLD=0.4
