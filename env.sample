# Copy this file to `.env` in the repo root (next to the root package.json).
# Required for `npm run dev` (API + Expo web) / production API.
#
# Use the same value for both lines (or generate a new secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
API_KEY=f8c4a21e9d0b3675543210fedcba9876543210fedcba9876543210fedcba98
VITE_API_KEY=f8c4a21e9d0b3675543210fedcba9876543210fedcba9876543210fedcba98

# PostgreSQL (same pattern as travel_app: Prisma + @prisma/adapter-pg).
# Start local DB: `docker compose up -d` from the repo root (maps host port 5433).
DATABASE_URL=postgresql://auction:auction_dev@localhost:5433/react_sample_auction?schema=public

# Expo (optional; app.config.ts also reads VITE_API_KEY for the API secret).
# EXPO_PUBLIC_API_ORIGIN=http://127.0.0.1:3847
# EXPO_PUBLIC_API_KEY=<same as API_KEY>

# Roboflow Discovery matching (server only).
# Model id format is usually "project/version", e.g. "rockefeller-artworks/1".
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
# Optional full endpoint override.
ROBOFLOW_INFERENCE_URL=
DISCOVERY_MATCH_THRESHOLD=0.4
